# ---------------------------------------------------------------------------
# Environment contract. Copy to `.env.local` and fill in.
#
#   cp .env.example .env.local
#
# This file is the checked-in source of truth for *which* variables exist.
# `src/shared/config/env.ts` (public) and `server-env.ts` (secret) are the
# source of truth for their *shape* — the app refuses to boot if they disagree.
# ---------------------------------------------------------------------------

# --- Public (inlined into the browser bundle — never put a secret here) -----

# Absolute origin the app is served from. Used for canonical URLs and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only ------------------------------------------------------------

# --- Supabase ---------------------------------------------------------------

# Project URL and publishable key. Both are safe in the browser; RLS is what
# protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Bypasses RLS. Server-only, never inlined into a bundle.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Ingestion --------------------------------------------------------------

# Finnhub company-news API. Free tier is enough for a nightly run.
# Required by `pnpm ingest`; the app itself boots without it.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# Near-duplicate detection. The model runs locally on CPU — no key, no per-article cost.
# EMBEDDING_DIMENSIONS must match the `articles.embedding` column.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Cosine distance under which two articles are treated as the same story.
#
# Deliberately tight. Measured over 403 real articles, "same story, different outlet" and
# "same stock, different story" overlap between roughly 0.10 and 0.14 — the headlines are
# too short to separate them. A false collapse is the expensive error, because the
# duplicate never gets summarised and the story silently disappears; a missed duplicate
# only costs a repeated line. So this errs towards missing.
NEAR_DUPLICATE_DISTANCE=0.08

# How many days back each run asks the sources for.
INGEST_LOOKBACK_DAYS=1

# --- Summarisation ----------------------------------------------------------

# How summarisation reaches the model. One of:
#   api         the Messages API, billed to ANTHROPIC_API_KEY (the default, and what CI uses)
#   claude-cli  the local `claude` CLI, billed to the Claude subscription it is signed in to.
#               Local development only; needs Claude Code installed and logged in.
SUMMARY_BACKEND=api

# Required when SUMMARY_BACKEND is api. Nothing boots without it, on purpose: a missing key
# should fail loudly at startup rather than halfway through a nightly run.
ANTHROPIC_API_KEY=sk-ant-...

# Haiku is the cheap tier: $1/1M input, $5/1M output. A nightly run of ~350 articles
# costs a few cents, because the article bodies feeds give us are ~260 characters.
SUMMARY_MODEL=claude-haiku-4-5

# Dollars per million tokens, used only to report what a run cost. They belong to the model
# above — change SUMMARY_MODEL and these two must change with it, or the reported cost is
# quietly wrong.
SUMMARY_PRICE_INPUT_PER_MTOK=1
SUMMARY_PRICE_OUTPUT_PER_MTOK=5

# Part of the (article_id, model, prompt_version) key. Bump it when the prompt changes:
# old rows stay, so a prompt regression can be compared against, not just discovered.
SUMMARY_PROMPT_VERSION=v1

# Guardrails. The first bounds the bill if something goes wrong; the second is how many
# requests are in flight at once.
MAX_SUMMARIES_PER_RUN=500
SUMMARY_CONCURRENCY=4

# Minimum instrument-link confidence for an article to be worth summarising. At 0.7 this
# means Finnhub's per-symbol news and text mentions, but not ETF bucket matches — nothing
# publishes "SPY news", so those links are a proxy rather than evidence.
MIN_MATCH_CONFIDENCE=0.7

# One of: debug | info | warn | error | silent. Defaults to info.
LOG_LEVEL=info
