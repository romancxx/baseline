# ---------------------------------------------------------------------------
# Environment contract. Copy to `.env.local` and fill in.
#
#   cp .env.example .env.local
#
# This file is the checked-in source of truth for *which* variables exist.
# `src/shared/config/env.ts` (public) and `server-env.ts` (secret) are the
# source of truth for their *shape* — the app refuses to boot if they disagree.
# ---------------------------------------------------------------------------

# --- Public (inlined into the browser bundle — never put a secret here) -----

# Absolute origin the app is served from. Used for canonical URLs and metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only ------------------------------------------------------------

# The API's origin, without `/api/v1`. Reached only from Next's server, never
# from the browser.
API_BASE_URL=http://localhost:8000

# --- Supabase ---------------------------------------------------------------

# Project URL and publishable key. Both are safe in the browser; RLS is what
# protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Bypasses RLS. Server-only, never inlined into a bundle.
SUPABASE_SECRET_KEY=sb_secret_...

# One of: debug | info | warn | error | silent. Defaults to info.
LOG_LEVEL=info
