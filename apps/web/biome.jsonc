{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/.next",
      "!**/coverage",
      "!next-env.d.ts",
      // Generated by `pnpm db:types`; formatting it would fight the generator.
      "!src/shared/supabase/database.types.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    // `project` unlocks the cross-file rules (import cycles, unresolved imports) that keep
    // the feature slices from quietly growing into a ball of mud.
    "domains": {
      "next": "recommended",
      "tailwind": "recommended",
      "react": "recommended",
      "test": "recommended",
      "project": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "error"
      },
      "nursery": {
        "noTailwindArbitraryValue": {
          "level": "error",
          "options": { "functions": ["cn"] }
        },
        "noInlineStyles": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": { "allow": ["error", "warn"] }
        }
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "filenameCases": ["kebab-case"]
          }
        },
        // ---------------------------------------------------------------
        // Boundary #1: a feature is reached through `@/features/<name>` or
        // `@/features/<name>/server`, never by importing its internals.
        //
        // Imports are absolute everywhere, including inside a feature, so a
        // feature re-allows its own internals in an override below. A new
        // feature without that override fails here — deliberately loudly.
        // ---------------------------------------------------------------
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/features/*/**", "!@/features/*/server"],
                "message": "Import a feature through its entry point (`@/features/news` or `@/features/news/server`), not its internals."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    // ---------------------------------------------------------------
    // Architecture boundary #2: `shared` is the bottom of the stack. It
    // may not know that features or routes exist.
    // ---------------------------------------------------------------
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/features/**", "@/app/**"],
                    "message": "`shared` is the lowest layer: it must not depend on features or routes. Move the shared piece down, or the feature-specific piece up."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Features may depend on `shared` and on other features' entry points, never on
    // routes. Each feature then re-allows its own internals — add a block per feature.
    {
      "includes": ["src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "Features must not import from `app/`. Routes compose features, not the other way round."
                  },
                  {
                    "group": ["@/features/*/**", "!@/features/*/server"],
                    "message": "Import another feature through its entry point (`@/features/news` or `@/features/news/server`), not its internals."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/auth/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "Features must not import from `app/`. Routes compose features, not the other way round."
                  },
                  {
                    "group": ["@/features/*/**", "!@/features/*/server", "!@/features/auth/**"],
                    "message": "Import another feature through its entry point (`@/features/news` or `@/features/news/server`), not its internals."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/instruments/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "Features must not import from `app/`. Routes compose features, not the other way round."
                  },
                  {
                    "group": [
                      "@/features/*/**",
                      "!@/features/*/server",
                      "!@/features/instruments/**"
                    ],
                    "message": "Import another feature through its entry point (`@/features/news` or `@/features/news/server`), not its internals."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/portfolio/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "Features must not import from `app/`. Routes compose features, not the other way round."
                  },
                  {
                    "group": [
                      "@/features/*/**",
                      "!@/features/*/server",
                      "!@/features/portfolio/**"
                    ],
                    "message": "Import another feature through its entry point (`@/features/news` or `@/features/news/server`), not its internals."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/news/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**"],
                    "message": "Features must not import from `app/`. Routes compose features, not the other way round."
                  },
                  {
                    "group": ["@/features/*/**", "!@/features/*/server", "!@/features/news/**"],
                    "message": "Import another feature through its entry point (`@/features/news` or `@/features/news/server`), not its internals."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Next.js reserves these filenames; they are not ours to rename.
    {
      "includes": ["src/app/**", "*.config.ts", "*.config.js"],
      "linter": {
        "rules": {
          "style": { "useFilenamingConvention": "off" }
        }
      }
    },
    // Tests lean on fixtures and non-null assertions; that is fine in a test.
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "vitest.setup.ts"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noConsole": "off" }
        }
      }
    }
  ]
}
