ENVIRONMENT=local
DEBUG=true

POSTGRES_USER=baseline
POSTGRES_PASSWORD=baseline
POSTGRES_DB=baseline
DATABASE_URL=postgresql+asyncpg://baseline:baseline@localhost:5432/baseline

JWT_SECRET=change-me-to-the-output-of-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Optional: raises OpenFIGI's limits
# OPENFIGI_API_KEY=

# Optional: briefs use this key, or the logged-in `claude` CLI with LLM_BACKEND=cli. Without
# the chosen backend, news has headlines but no briefs.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# LLM_BACKEND=api

# Optional: the currency FX rates convert into. Changing it needs the fx_rates table emptied.
# BASE_CURRENCY=EUR
